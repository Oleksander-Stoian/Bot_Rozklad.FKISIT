# Скопіюйте у .env і заповніть реальними значеннями. НЕ КОМІТЬТЕ .env у git!
# .env уже в .gitignore. Перед першим комітом переконайтесь: git check-ignore .env

# Токен бота від @BotFather
BOT_TOKEN=

# Telegram ID адміністраторів через кому (доступ до /admin, панелі, розсилок)
ADMIN_IDS=

# Redis (у docker-compose хост = redis)
REDIS_HOST=redis
REDIS_PORT=6379

# Секрет для підпису сесій веб-панелі — ОБОВ'ЯЗКОВО окремий від BOT_TOKEN.
# Згенеруйте: openssl rand -hex 32
SESSION_SECRET=

# Браузерний вхід у панель (окремо від Telegram Mini App).
# ADMIN_PASS_HASH — sha256-hex від пароля: echo -n 'ваш_пароль' | sha256sum
ADMIN_USER=
ADMIN_PASS_HASH=

# Публічний URL веб-панелі (для кнопки WebApp у /admin)
WEBAPP_URL=
